# Dev: backend that Vite proxies /api to (defaults to the production backend).
API_PROXY_TARGET=https://estore-backend-rdnf.onrender.com
# Production: absolute backend origin. Leave empty in dev to use the proxy.
VITE_API_URL=
# Storefront only: root domain whose subdomains are stores (e.g. mystore.example.com).
VITE_PLATFORM_DOMAIN=
# Admin origin allowed to drive the live editor preview.
VITE_ADMIN_ORIGIN=http://localhost:5173
