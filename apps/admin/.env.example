# Dev: backend that Vite proxies /api to (defaults to the production backend).
API_PROXY_TARGET=https://estore-backend-rdnf.onrender.com
# Production: absolute backend origin. Leave empty in dev to use the proxy.
VITE_API_URL=
# Root domain whose subdomains are stores (shop.mariseh.com). Set it only once the wildcard *.mariseh.com works — the admin then shares shop.mariseh.com links.
VITE_PLATFORM_DOMAIN=
# Image uploads (unsigned preset — safe for the browser).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_API_KEY=
# Where the storefront runs (used for the editor preview + "View store" links).
VITE_STOREFRONT_ORIGIN=http://localhost:5174
